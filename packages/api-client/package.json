    "@tuyau/react-query": "^1.1.0",
    "@types/node": "^24.3.0",
    "tsup": "^8.5.1",
    "typescript": "~6.0.3"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.102.8",
    "@tuyau/react-query": "^1.1.0"
  }
}
